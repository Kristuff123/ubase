# Skopiuj do deploy/.env i uzupełnij.
# Ten plik NIE zawiera sekretów — klucze leżą w deploy/secrets/.

# Domena, na którą wystawiasz aplikację (Caddy pobierze certyfikat Let's Encrypt).
USERBASE_HOST=userbase.example.com

# Ile kopii zapasowych trzymać (starsze są usuwane).
USERBASE_BACKUP_KEEP=14
