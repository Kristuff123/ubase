# Caddy — reverse proxy z automatycznym TLS (Let's Encrypt).
# HSTS dokładamy tutaj; aplikacja ustawia go tylko w produkcji, ale nagłówek
# z proxy jest bardziej wiarygodny dla przeglądarki.

{$USERBASE_HOST} {
	encode zstd gzip

	# Nagłówki bezpieczeństwa. CSP pochodzi z aplikacji (wie o nonce/hydratacji).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Limity rozmiaru: import .xlsx to max 10 MB, z zapasem na narzut multipart.
	request_body {
		max_size 12MB
	}

	# X-Forwarded-For: Caddy dopisuje adres klienta. Aplikacja ufa OSTATNIEMU wpisowi
	# (patrz clientIpFromHeaders), więc nie można go podrobić z zewnątrz.
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
